# Copy to .env and fill in. Never commit .env.

# Required
SECRET_KEY=            # 32+ random bytes, e.g. `openssl rand -hex 32`

# Infrastructure (defaults match compose.yaml)
POSTGRES_PASSWORD=ledgerlens
MINIO_ROOT_USER=ledgerlens
MINIO_ROOT_PASSWORD=ledgerlens-secret

# Optional: payments in Stripe test mode. Leave empty to use FakeBilling.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: ML
LOW_VRAM=0             # 1 for 8 GB GPUs: 4-bit base, 768 px image cap
HF_TOKEN=              # only if a gated dataset (DocILE mirror) needs it

# Local-only
LOG_LEVEL=INFO
ENVIRONMENT=local
LEDGERLENS_NATIVE_TLS=0   # 1 behind a corporate TLS proxy: trust the OS certificate store
